# Clutch cloud server configuration. Copy to .env and fill in what you use.
PORT=8787
# Public URL people and OAuth providers reach this server at (no trailing slash).
PUBLIC_URL=http://127.0.0.1:8787
# Long random string. Signs login tokens and upload tokens. Change it in production!
JWT_SECRET=change-me-to-a-long-random-string

# Sign-in providers (create apps in their developer consoles; redirect URI = PUBLIC_URL/auth/<provider>/callback)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Lets anyone sign in by typing a name. Only for local testing!
DEV_LOGIN=0

# Storage: "local" keeps files in DATA_DIR/files; "s3" uses any S3-compatible bucket (Cloudflare R2 recommended: no download fees)
STORAGE=local
DATA_DIR=./data
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=clutch-clips
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Subscriptions (Stripe). Price = the recurring price id of "Clutch Pro".
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
