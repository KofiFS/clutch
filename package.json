{
  "name": "clutch",
  "version": "0.1.0",
  "description": "Clutch - a smart game clip recorder: tell it what to clip, pick quality, share to Discord and YouTube.",
  "main": "./out/main/index.js",
  "author": {
    "name": "iceko"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "googleapis": "^160.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "build": {
    "appId": "com.iceko.clutch",
    "productName": "Clutch",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "icon*.png",
          "icon.ico",
          "ocr.ps1"
        ]
      },
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "*.exe",
          "LICENSE*"
        ]
      },
      {
        "from": ".",
        "to": ".",
        "filter": [
          "LICENSE",
          "THIRD_PARTY_NOTICES.md"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clutch",
      "artifactName": "Clutch-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": null
  },
  "productName": "Clutch",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/KofiFS/clutch",
  "repository": {
    "type": "git",
    "url": "https://github.com/KofiFS/clutch.git"
  }
}
